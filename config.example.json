{
  "db_host": "127.0.0.1",
  "db_user": "flightwatch",
  "db_name": "flightwatch",
  "db_pass_file": "/opt/flightwatch/.mysql_pass",

  "mqtt_host": "127.0.0.1",
  "mqtt_port": 1883,
  "mqtt_user": "flightwatch",
  "mqtt_pass_file": "/opt/flightwatch/.mqtt_pass",
  "mqtt_prefix": "flightwatch",
  "mqtt_client_id": "flightwatch",
  "discovery_prefix": "homeassistant",

  "channels": ["telegram", "sms"],
  "notify": true,

  "telegram_chat_id": 0,
  "telegram_token_file": "/opt/flightwatch/.tg_token",

  "sms_to": "+70000000000",
